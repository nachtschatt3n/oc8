# syntax=docker/dockerfile:1
#
# FORK DIVERGENCE (nachtschatt3n/oc8): the build context is the REPOSITORY
# ROOT, not ./backend as upstream declares, and the runtime stage bakes in the
# repo-root `capas/` and `i18n/` trees.
#
# WHY: both trees are resolved at RUNTIME as paths relative to the working
# directory -- OC8_CAPAS_PATH=/app/capas, and core_i18n_path="i18n" -> /app/i18n.
# Neither is reachable from a ./backend context. Upstream's Helm chart expects
# an operator to supply capas via a hostPath mount or a pre-populated PVC;
# on Talos there is no node filesystem to bind, and a PVC for 6 MB of static
# files would need its own populate Job. Baking them into the image we already
# build is simpler and makes the image self-contained.
#
# Kept as a patch to upstream's own file rather than a separate overlay so that
# an upstream change to this Dockerfile surfaces as a git conflict here instead
# of drifting silently.
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /bin/uv
ENV UV_LINK_MODE=copy
WORKDIR /app
# Install into a self-contained venv. No uv.lock in the repo, so resolve from
# pyproject.toml directly. src/ is needed at build time because the hatchling
# build reads src/oc8.
COPY backend/pyproject.toml ./
COPY backend/src ./src
RUN uv venv /opt/venv && VIRTUAL_ENV=/opt/venv uv pip install .

FROM python:3.12-slim AS runtime
# libpq/build tools are not needed: asyncpg and psycopg[binary] ship wheels,
# cryptography ships manylinux wheels.
COPY --from=build /opt/venv /opt/venv
# Tool-pack plugins may declare Python MCP bridges launched via ``uvx``.
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv
RUN ln -s /usr/local/bin/uv /usr/local/bin/uvx
# node/npx, for tool-pack plugins whose MCP bridge is only published as an npm
# package. Pinned to -bookworm-slim so its glibc matches this Debian base.
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
# github_mcp's bridge: GitHub's own official binary. Pinned, never `:latest`.
COPY --from=ghcr.io/github/github-mcp-server:v1.9.0 /server/github-mcp-server /usr/local/bin/github-mcp-server
WORKDIR /app
# alembic needs alembic.ini + migrations/ next to it; oc8 itself is installed
# into the venv, so src/ is not copied into the runtime.
COPY backend/alembic.ini ./
COPY backend/migrations ./migrations
# Fork divergence (see header): runtime-resolved trees the ./backend context
# could not reach.
COPY capas /app/capas
COPY i18n /app/i18n
ENV PATH="/opt/venv/bin:$PATH"
EXPOSE 8099
CMD ["uvicorn", "oc8.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8099"]
